{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.samdidos/json-schema-toolkit",
  "title": "JSON Schema Toolkit",
  "description": "Deterministic JSON Schema tools: validate, lint, diff with a compatibility verdict, bundle, infer.",
  "repository": {
    "url": "https://github.com/samdidos/vscode-json-schema-preview",
    "source": "github",
    "subfolder": "cli"
  },
  "version": "0.21.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "json-schema-toolkit",
      "version": "0.21.0",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp", "description": "Serve the tool surface over stdio." }
      ]
    }
  ]
}
